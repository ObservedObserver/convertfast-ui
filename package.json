{
  "name": "convertfast-ui-devspace",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Observed Observer",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "templates/*"
  ],
  "scripts": {
    "build": "yarn workspace convertfast-ui build",
    "registry:build": "yarn workspace @convertfast/registry build",
    "registry:validate": "yarn workspace @convertfast/registry validate",
    "test": "node --test tests/cli.test.mjs",
    "test:release": "node scripts/test-release.mjs",
    "typecheck": "yarn workspace convertfast-ui typecheck"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 120
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "yarn@1.22.19"
}
